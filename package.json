{
  "name": "logger",
  "private": true,
  "version": "0.1.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "electron": "electron electron/main.js",
    "desktop": "concurrently \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.8.2",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.attensi.timelogger",
    "productName": "Time Logger",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
