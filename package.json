{
  "name": "logger",
  "private": true,
  "version": "0.1.5",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "electron": "electron electron/main.js",
    "desktop": "concurrently \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.attensi.timelogger",
    "productName": "Time Logger",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "crazybki",
      "repo": "logger",
      "releaseType": "release"
    },
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
